   "source": [
    "## 1. Engine de Leitura Dinâmica SESP\n",
    "Lida com as anomalias de formatação das planilhas governamentais (linhas de cabeçalho vazias, encodings, etc)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def carregar_base_vida(caminho, pular_linhas=5, separador=';'):\n",
    "    try:\n",
    "        df = pd.read_csv(caminho, sep=separador, encoding='latin1', skiprows=pular_linhas, on_bad_lines='skip')\n",
    "        # Limpeza básica de rodapés\n",
    "        if 'Município' in df.columns:\n",
    "            df = df[df['Município'].notna()]\n",
    "            df = df[~df['Município'].str.contains('Fonte|Total|Nota', case=False, na=False)]\n",
    "            df['Município'] = df['Município'].str.strip().str.upper()\n",
    "        return df\n",
    "    except Exception as e:\n",
    "        print(f\"Erro ao carregar {caminho}: {e}\")\n",
    "        return pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## INSIGHT 1: Ranking de Letalidade e Evolução Temporal\n",
    "Qual é a trajetória real da violência letal nas 10 cidades mais críticas?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pseudo-código para o Dashboard (Substitua pelos dfs carregados)\n",
    "def plot_evolucao_homicidios(df_historico):\n",
    "    \"\"\"\n",
    "    Gera o gráfico de evolução anual. Ideal para converter em st.plotly_chart() no app.\n",
    "    \"\"\"\n",
    "    df_melted = df_historico.melt(id_vars=['Município'], var_name='Ano', value_name='Homicidios')\n",
    "    top_10 = df_melted.groupby('Município')['Homicidios'].sum().nlargest(10).index\n",
    "    df_top10 = df_melted[df_melted['Município'].isin(top_10)]\n",
    "    \n",
    "    fig = px.line(df_top10, x='Ano', y='Homicidios', color='Município', markers=True,\n",
    "                  title='Evolução de Homicídios Dolosos (Top 10 Municípios)')\n",
    "    return fig"
   ]
